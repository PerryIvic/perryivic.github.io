---
import ProjectCard from "./ProjectCard.astro";
import type { ProjectData } from "../types/project-data";

interface Props {
    projects: ProjectData[];
    columns?: 1 | 2 | 3;
}

const {
    projects,
    columns = 3
} = Astro.props;
---
<style>
.grid {
    display: grid;

    width: min(1300px, 95%);
    margin: 2rem auto;

    justify-content: center;
    gap: 2rem;
}

.grid-1 {
    grid-template-columns: minmax(0, calc((100% - 4rem) / 2));
}

.grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

@media (max-width: 900px) {
    .grid {
        width: 92%;
        gap: 1.5rem;
    }

    .grid-3 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    .grid {
        width: calc(100% - 1.5rem);
        gap: 1rem;
    }

    .grid-2,
    .grid-3 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .grid-1 {
        grid-template-columns: minmax(0, calc((100% - 1rem) / 2));
        justify-content: center;
    }
}

@media (max-width: 380px) {
    .grid {
        width: calc(100% - 1rem);
        gap: 0.75rem;
    }

    .grid-1 {
        grid-template-columns: minmax(0, calc((100% - 0.75rem) / 2));
    }
}
</style>

<div class={`grid grid-${columns}`}>
    {projects.map(project => (
        <ProjectCard project={project} />
    ))}
</div>