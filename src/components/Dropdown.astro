---
interface Props {
  href: string;
  label: string;
  currentPath: string;
  items: {
    href: string;
    text: string;
  }[];
}

const { href, label, currentPath, items } = Astro.props;

const isActive =
  currentPath === href ||
  items.some((item) => currentPath === item.href);
---

<style> 
.dropdown { 
    position: relative; 
} 

.dropdown-menu { 
    position: absolute; 
    top: 100%; 
    left: 0; 
    z-index: 10; 
    display: grid; 
    grid-template-rows: 0fr; 
    min-width: max-content; 
    margin: 0; 
    padding: 0; 
    list-style: none; 

    background: #222;
    border: 1px solid #444;
    border-radius: 8px;
    
    opacity: 0; 
    overflow: hidden; 
    pointer-events: none; 
    transition: grid-template-rows 0.2s ease, opacity 0.2s ease, padding 0.2s ease; 
} 

.dropdown-menu > li { 
    min-height: 0; 
} .dropdown.open 
.dropdown-menu { 
    grid-template-rows: 1fr; padding: 0.75rem 0; opacity: 1; pointer-events: auto; 
} 

.dropdown-menu .nav-link { 
    padding: 0.5rem 1rem; 
    white-space: nowrap; 
} 

@media (min-width: 769px) { 
    .dropdown:hover .dropdown-menu { 
        grid-template-rows: 1fr; 
        padding: 0.75rem 0; 
        opacity: 1; 
        pointer-events: auto; 
    } 
} @media (max-width: 768px) { 
    .dropdown-menu { 
        top: calc(100% + 0.5rem); 
        left: 0; 
    } 
} 
</style>

<li class="dropdown">
  <a
    href={href}
    class:list={[
      "nav-link",
      "dropdown-trigger",
      { active: isActive }
    ]}
  >
    {label}
  </a>

  <ul class="dropdown-menu">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          class:list={[
            "nav-link",
            { active: currentPath === item.href }
          ]}
        >
          {item.text}
        </a>
      </li>
    ))}
  </ul>
</li>

<script>
  const dropdowns = document.querySelectorAll(".dropdown");

  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector(".dropdown-trigger");

    if (!trigger) return;

    trigger.addEventListener("click", (event) => {
      if (window.innerWidth <= 768) {
        event.preventDefault();

        dropdowns.forEach((otherDropdown) => {
          if (otherDropdown !== dropdown) {
            otherDropdown.classList.remove("open");
          }
        });

        dropdown.classList.toggle("open");
      }
    });
  });
</script>
