---
import { Image } from 'astro:assets';
import EntryIcon from "../assets/entry-border-icon.png"

const alt = "Border icon"
---

<style> 
.entry-border { 
    display: flex; 
    align-items: center; 
    width: calc(100% - 3rem);
    max-width: 1300px;
    margin: 2rem auto;
    gap: clamp(0.75rem, 3vw, 1.5rem); 
} 
    
.line { 
    flex: 1; 
    height: 1px; 
    background: #555; 
} 
    
.divider-image { 
    width: clamp(2rem, 8vw, 4rem); 
    height: auto; flex: 0 0 auto; 
} 
@media (max-width: 480px) { 
    .divider-image {
        width: 2.5rem; 
    } 
} 
</style>

<div class="entry-border" aria-hidden="true"> 
    <div class="line"></div> 
    
    <Image src={EntryIcon} alt={alt} class="divider-image" /> 

    <div class="line"></div> 
</div>
