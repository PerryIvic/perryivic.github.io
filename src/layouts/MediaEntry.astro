---
interface Props {
    mediaSide?: "left" | "right";
}

const {
    mediaSide = "left"
} = Astro.props;
---

<style>
.media-entry {
    display: flex;
    align-items: flex-start;

    width: min(1300px, 90%);
    margin: 1rem auto;
    gap: 3rem;
}

.media,
.content {
    flex: 1;
    min-width: 0;
    display: flex;
    margin-top: 3rem;
}

.media {
    justify-content: flex-end;
    align-items: center;
    flex-direction: column;
}

.media > * {
    width: 100%;
}

.content {
    justify-content: flex-start;
}

.reverse {
    flex-direction: row-reverse;
}

.reverse .media {
    justify-content: flex-start;
    align-items: center;
    flex-direction: column;
}

.reverse .content {
    justify-content: flex-end;
}

@media (max-width: 768px) { 
    .media-entry, 
    .media-entry.reverse { 
        flex-direction: column; 
        width: calc(100% - 2rem); 
        gap: 1.5rem; 
        margin: 1rem auto; 
    } 
        
    .media, 
    .content, 
    .reverse 
    .media, 
    .reverse 
    .content { 
        width: 100%; 
        max-width: 100%; 
        margin-top: 1rem; 
        justify-content: center; 
        align-items: center; 
    } 
    
    .media > * { 
        width: 100%; 
        max-width: 100%; 
    } 
} 

@media (max-width: 480px) { 
    .media-entry, 
    .media-entry.reverse { 
        width: calc(100% - 2rem); 
        gap: 1rem; 
    } 
    .media, 
    .content, 
    .reverse 
    .media, 
    .reverse 
    .content { 
        margin-top: 0.5rem; 
    } 
}
</style>

<section class:list={["media-entry", mediaSide === "right" && "reverse"]}>
    <div class="media">
        <slot name="media" />
    </div>

    <div class="content">
        <slot name="content"/>
    </div>
</section>
