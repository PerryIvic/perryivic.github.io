---
import Header from '../components/Header.astro';
import EntryBorder from "../components/EntryBorder.astro";
import '../styles/global.css';

interface Props {
  pageTitle : string;
  showBackToTop?: boolean;
}

const {pageTitle, showBackToTop } = Astro.props
const pageSuffix = "Perry Ivic's Software Developer Portfolio"

---

<style> 
.page-container { 
  width: min(100% - 2rem, 1300px); 
  margin-inline: auto; 
} 

html {
    scroll-behavior: smooth;
}

.back-to-top {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 3rem;
  height: 3rem;
  margin: 1.0rem auto 4.0rem auto;

  border-radius: 50%;
  background: #333;
  color: white;
  text-decoration: none;
  font-size: 1.25rem;
  line-height: 1;

  transition: transform 0.2s ease;
}

.back-to-top:hover {
  background: #555;
  transform: translateY(-2px);
}
  
</style>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle + " | " + pageSuffix}</title>
  </head>
  
  <body id="top">
    <Header />
    
    <main class="page-container"> 
      <slot /> 
    </main>
    <EntryBorder/>
    
    <footer>
      {showBackToTop && (
        <a href="#top" class="back-to-top" aria-label="Back to top">
          ↑
        </a>
      )}
    </footer>
  </body>
</html>

